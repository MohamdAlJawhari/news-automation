// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  OWNER
  USER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  platformRole   PlatformRole   @default(USER)
  approvalStatus ApprovalStatus @default(PENDING)

  sessions  Session[]
  accounts  Account[]
  workspace Workspace?

  @@index([approvalStatus])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id   String @id @default(cuid())
  name String

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  rssEnabled        Boolean @default(false)
  automationEnabled Boolean @default(false)

  campaignAiSettings CampaignAiSettings[]
  campaignPublishingSettings CampaignPublishingSettings[]
  telegramState WorkspaceTelegramState?
  // Retained read-only after campaign-settings cutover.
  aiSettings WorkspaceAiSettings?
  aiDrafts AiDraft[]
  publishingSettings WorkspacePublishingSettings?
  publications TelegramPublication[]
  rssFeeds RssFeed[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  sourceChannels SourceChannel[]
  campaigns      Campaign[]
  campaignSources CampaignSource[]

  @@map("workspace")
}

enum ProcessingJobType {
  RSS_PREPARE
  TELEGRAM_PREPARE
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model SourceChannel {
  id          String @id @default(cuid())
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  username       String
  telegramChatId String?
  title          String?
  enabled        Boolean @default(true)
  telegramAutomationEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  originalPosts OriginalPost[]
  rssFeed       RssFeed?
  campaignSources CampaignSource[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, username])
  @@unique([workspaceId, telegramChatId])
  @@index([workspaceId, enabled])
  @@map("source_channel")
}

model OriginalPost {
  id              String @id @default(cuid())
  workspaceId     String
  sourceChannelId String

  sourceChannel SourceChannel @relation(fields: [sourceChannelId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  telegramChatId    String
  telegramMessageId Int
  sourceUrl         String?
  originalText      String

  publishedAt DateTime
  receivedAt  DateTime @default(now())

  aiDrafts AiDraft[]
  rssItem RssItem?

  jobs ProcessingJob[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, telegramChatId, telegramMessageId])
  @@index([workspaceId, publishedAt])
  @@index([sourceChannelId, workspaceId])
  @@map("original_post")
}

model ProcessingJob {
  id             String @id @default(cuid())
  workspaceId    String
  originalPostId String

  originalPost OriginalPost @relation(fields: [originalPostId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  // SQL requires campaign identity for Telegram; RSS must leave it null.
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  type   ProcessingJobType
  status ProcessingJobStatus @default(PENDING)

  attempts    Int      @default(0)
  autoSendGeneration Int?
  availableAt DateTime @default(now())

  lockedUntil DateTime?
  lockToken   String?

  outcome     String?
  lastError   String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // The nullable campaign column plus SQL type-dependent check and partial RSS
  // index enforce one Telegram job per campaign and one independent RSS job.
  @@unique([originalPostId, type, campaignId])
  @@index([status, availableAt])
  @@index([status, lockedUntil])
  @@index([workspaceId, status])
  @@index([originalPostId, workspaceId])
  @@index([campaignId, workspaceId])
  @@map("processing_job")
}

model RssFeed {
  id String @id @default(cuid())

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sourceChannelId String @unique

  sourceChannel SourceChannel @relation(fields: [sourceChannelId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  title       String @default("News feed")
  description String @default("Latest news from selected sources.")

  enabled   Boolean @default(false)
  tokenHash String? @unique

  headerText String @default("")
  footerText String @default("")

  removeKeywords String[] @default([])
  replaceRules   Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items RssItem[]

  @@unique([sourceChannelId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("rss_feed")
}

model RssItem {
  id             String @id @default(cuid())
  workspaceId    String
  feedId         String
  originalPostId String

  feed RssFeed @relation(fields: [feedId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  originalPost OriginalPost @relation(fields: [originalPostId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  title       String
  content     String
  sourceUrl   String?
  publishedAt DateTime

  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([originalPostId, workspaceId])
  @@index([feedId, workspaceId, visible, publishedAt])
  @@map("rss_item")
}

model WorkspaceAiSettings {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  enabled Boolean @default(false)
  systemPrompt String
  editorialPerspective String @default("")
  model String @default("gpt-oss:latest")
  activatedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("workspace_ai_settings")
}

enum AiReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model AiDraft {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  originalPostId String
  originalPost OriginalPost @relation(fields: [originalPostId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  // Required identity is immutable in SQL. Publications derive campaign
  // through this draft without rewriting historical snapshots.
  campaignId String
  campaign Campaign @relation(fields: [campaignId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  aiText String
  finalText String
  reviewStatus AiReviewStatus @default(PENDING_REVIEW)
  approvalMode String?
  autoSendGeneration Int?
  manualAttentionReason String?
  model String
  effectivePrompt String
  settingsRevision Int
  editRevision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  publications TelegramPublication[]
  @@unique([id, workspaceId])
  @@unique([originalPostId, campaignId])
  @@index([workspaceId, createdAt])
  @@index([campaignId, workspaceId])
  @@map("ai_draft")
}

model Campaign {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name String
  autoSendEnabled Boolean @default(false)
  autoSendActivatedAt DateTime?
  autoSendGeneration Int @default(0)
  autoSendRevision Int @default(1)
  executionStartsAt DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())"))
  // SQL enforces at most one default per workspace with a partial unique index.
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  aiSettings CampaignAiSettings?
  publishingSettings CampaignPublishingSettings?
  sources CampaignSource[]
  aiDrafts AiDraft[]
  processingJobs ProcessingJob[]
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("campaign")
}

model CampaignSource {
  campaignId String
  sourceChannelId String
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  sourceChannel SourceChannel @relation(fields: [sourceChannelId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  telegramAutomationEnabled Boolean @default(false)
  eligibleAfter DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())"))
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@id([campaignId, sourceChannelId])
  @@index([workspaceId, campaignId])
  @@index([sourceChannelId, workspaceId])
  @@map("campaign_source")
}

enum TelegramPublicationStatus {
  QUEUED
  SENDING
  PUBLISHED
  FAILED
  DELIVERY_UNKNOWN
}

model WorkspacePublishingSettings {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  enabled Boolean @default(false)
  destinationUsername String @default("")
  destinationChatId String?
  verifiedAt DateTime?
  verificationError String?
  verificationPending Boolean @default(false)
  floodWaitUntil DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("workspace_publishing_settings")
}

model TelegramPublication {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  draftId String
  draft AiDraft @relation(fields: [draftId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  draftRevision Int
  deliveryMode String @default("MANUAL")
  queuedAutomatically Boolean @default(false)
  autoSendGeneration Int?
  text String
  destinationChatId String
  destinationUsername String
  destinationRevision Int
  randomId String @unique
  status TelegramPublicationStatus @default(QUEUED)
  availableAt DateTime @default(now())
  lockToken String?
  lockedUntil DateTime?
  dispatchedAt DateTime?
  telegramMessageId Int?
  confirmedChatId String?
  publishedAt DateTime?
  lastError String?
  recoveryMessageId Int?
  recoveryNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([draftId, draftRevision])
  @@index([workspaceId, status, availableAt])
  @@map("telegram_publication")
}

// Campaign configuration is authoritative; legacy workspace settings are frozen.
model CampaignAiSettings {
  campaignId String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  enabled Boolean @default(false)
  systemPrompt String
  editorialPerspective String @default("")
  model String @default("gpt-oss:latest")
  activatedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([campaignId, workspaceId])
  @@index([workspaceId])
  @@map("campaign_ai_settings")
}

model CampaignPublishingSettings {
  campaignId String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  enabled Boolean @default(false)
  destinationUsername String @default("")
  destinationChatId String?
  verifiedAt DateTime?
  verificationError String?
  verificationPending Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([campaignId, workspaceId])
  @@index([workspaceId])
  @@map("campaign_publishing_settings")
}

// Shared by every send through this workspace's existing connected account.
model WorkspaceTelegramState {
  workspaceId String @id
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  floodWaitUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("workspace_telegram_state")
}
